/dts-v1/;

#include "klamath.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "Synaptics Klamath Coralboard";
	compatible = "Synaptics,klamath", "Synaptics,asserial";

	memory {
		device_type = "memory";
		reg = <0 0 0 0x20000000>;
	};

	chosen {
		stdout-path = &sm_uart0;
	};

	regulators {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <0>;

		usb1_vbus: usb1-vbus {
			compatible = "regulator-fixed";
			regulator-name = "usb1_vbus";
			regulator-min-microvolt = <5000000>;
			regulator-max-microvolt = <5000000>;
			enable-active-high;
			gpio = <&portb 22 GPIO_ACTIVE_HIGH>;
		};

		sdio2_vmmc: sdio2-vmmc {
			compatible = "regulator-fixed";
			pinctrl-names = "default";
			pinctrl-0 = <&sdio2_vmmc_pmux>;
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
			regulator-name = "vmmc_sdio";
			enable-active-high;
			gpio = <&portb 21 GPIO_ACTIVE_HIGH>;
		};

		sdio2_vqmmc: sdio2-vqmmc {
			compatible = "regulator-gpio";
			pinctrl-names = "default";
			pinctrl-0 = <&sdio2_vqmmc_pmux>;
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <3300000>;
			regulator-name = "vqmmc_sdio";
			regulator-type = "voltage";
			states = <1800000 0x0 3300000 0x1>;
			gpios = <&portb 23 GPIO_ACTIVE_HIGH>;
		};
	};
};

&pinctrl {
	sdio2_pmux: sdio2-pmux {
		groups = "GPIO16", "GPIO17", "GPIO18", "GPIO19",
				 "GPIO20", "GPIO21", "GPIO22";
		function = "sdio2";
	};

	sdio2_vmmc_pmux: sdio2-vmmc-pmux {
		groups = "GPIO53";
		function = "gpio";
	};

	sdio2_vqmmc_pmux: sdio2-vqmmc-pmux {
		groups = "GPIO55";
		function = "gpio";
	};

	i2c3_pmux: i2c3-pmux {
		groups = "GPIO27", "GPIO28";
		function = "tw3";
	};
};

&sysmgr_pinctrl {
	xspi0_pmux: xspi0-pmux {
		groups = "SM_GPIO18", "SM_GPIO19", "SM_GPIO20", "SM_GPIO21",
				 "SM_GPIO22", "SM_GPIO23";
		function = "xspi";
	};
};

&sm_uart0 {
	status = "okay";
};

&sdhci0 {
	status = "okay";
	pad_sn = <10>;
	pad_sp = <10>;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	fixed-voltage;
};

&mux0 {
	status = "okay";
};

&sdhci2 {
	status="okay";
	pinctrl-0 = <&sdio2_pmux>;
	pinctrl-names = "default";
	sdhci-sdio;
	sd-uhs-sdr50;
	fixed-voltage;
	skip-phy;
	vmmc-supply = <&sdio2_vmmc>;
	vqmmc-supply = <&sdio2_vqmmc>;
	mux-controls = <&mux0 0>;
	mux-control-names = "mux-0";
	mux-0-value = <3>;
};

&usb_phy0 {
	status = "okay";
};

&usb0 {
	compatible = "snps,dwc2-udc";
	status = "okay";
};

&usb_phy1 {
	status = "okay";
};

&usb1 {
	compatible = "snps,dwc2-host";
	status = "okay";
	vbus-supply = <&usb1_vbus>;
};

&xspi0 {
	status = "okay";
	pinctrl-0 = <&xspi0_pmux>;
	pinctrl-names = "default";

	spi-flash@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <10000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
	};
};

&i2c3 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3_pmux>;
	clock-frequency = <100000>;

	rpi_panel_regulator: rpi_panel_regulator@45 {
		compatible = "raspberrypi,7inch-touchscreen-panel-regulator";
		reg = <0x45>;
		gpio-controller;
		#gpio-cells = <2>;
	};
};

&drm {
	status = "okay";
	irqno = <69>;
	disp-mode = <2>;

	dsi_panel {
		compatible = "syna,mipi-dsi";
		status= "okay";

		power-supply = <&rpi_panel_regulator>;
		backlight = <&rpi_panel_regulator>;
		compatible_panel = "raspberrypi,7inch-touchscreen-panel";

		NO_OF_RESID =  <1>;
		DSI_RES =  <102>;

		ACTIVE_WIDTH = <800>;
		HFP = <70>;
		HSYNCWIDTH = <20>;
		HBP = <26>;
		ACTIVE_HEIGHT = <480>;
		VFP = <7>;
		VSYNCWIDTH = <2>;
		VBP = <21>;
		TYPE = <1>;
		SCAN = <0>;
		FRAME_RATE = <9>;
		FLAG_3D = <0>;
		FREQ = <28030>;
		PTS_PER_4 = <6000>;

		bits_per_pixel = <24>;
		busformat = <0>;

		HTOTAL = <916>;
		Lanes = /bits/ 8 <1>;
		Vid_mode = /bits/ 8 <2>;
		virtual_chan = /bits/ 8 <0>;
		Clk_Lane_Polarity = /bits/ 8 <0>;
		Data_Lane_Polarity = /bits/ 8 <0>;
		Recv_ack = /bits/ 8 <0>;
		Loosely_18 = /bits/ 8 <0>;
		H_polarity = /bits/ 8 <1>;
		V_Polarity = /bits/ 8 <1>;
		Data_Polarity = /bits/ 8 <1>;
		Eotp_tx = /bits/ 8 <1>;
		Eotp_rx = /bits/ 8 <0>;
		non-Continuous_clk = /bits/ 8 <0>;
		dpi_lp_cmd = /bits/ 8 <1>;
		Color_coding = /bits/ 8 <5>;
		Chunks = <0>;
		Null_Pkt = <0>;
		Byte_clk = <84090>;
	};
};
