/dts-v1/;

#include "klamath.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "Synaptics KLAMATH RDK";
	compatible = "Synaptics,klamath", "Synaptics,asserial";

	memory {
		device_type = "memory";
		reg = <0 0 0 0x20000000>;
	};

	chosen {
		stdout-path = &sm_uart0;
	};

	regulators {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <0>;

		sdio2_vmmc: sdio2-vmmc {
			compatible = "regulator-fixed";
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
			regulator-name = "vmmc_sdio";
			enable-active-high;
			gpio = <&expander1 7 GPIO_ACTIVE_HIGH>;
		};

		sdio2_vqmmc: sdio2-vqmmc {
			compatible = "regulator-gpio";
			pinctrl-names = "default";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <3300000>;
			regulator-name = "vqmmc_sdio";
			regulator-type = "voltage";
			states = <1800000 0x1 3300000 0x0>;
			gpios = <&expander0 0 GPIO_ACTIVE_HIGH>;
		};
	};
};

&pinctrl {
	sdio2_pmux: sdio2-pmux {
		groups = "GPIO12", "GPIO16", "GPIO17", "GPIO18", "GPIO19",
				 "GPIO20", "GPIO21", "GPIO22";
		function = "sdio2";
	};

	mdio_pmux: mdio-pmux {
		groups = "GPIO31", "GPIO32";
		function = "rgmii";
	};

	eth1_pmux: eth1-pmux {
		groups = "GPIO48", "GPIO49", "GPIO50", "GPIO51", "GPIO52",
				 "GPIO53", "GPIO54", "GPIO55", "GPIO56", "GPIO57",
				 "GPIO58", "GPIO59";
		function = "rgmii2";
	};

	i2c2_pmux: i2c2-pmux {
		groups = "GPIO23", "GPIO24";
		function = "tw2";
	};
};

&sysmgr_pinctrl {
	i2c0_pmux: i2c0-pmux {
		groups = "SM_GPIO12", "SM_GPIO13";
		function = "tw0";
	};

	xspi0_pmux: xspi0-pmux {
		groups = "SM_GPIO18", "SM_GPIO19", "SM_GPIO20", "SM_GPIO21",
				 "SM_GPIO22", "SM_GPIO23", "SM_GPIO24", "SM_GPIO25",
				 "SM_GPIO26", "SM_GPIO27", "SM_GPIO28", "SM_GPIO29",
				 "SM_GPIO30";
		function = "xspi";
	};

	eth1_phy1_rst_pmux: eth1_phy1_rst_pmux {
		groups = "SM_GPIO35";
		function = "gpio";
	};
};

&i2c0 {
	status = "okay";
	pinctrl-0 = <&i2c0_pmux>;
	pinctrl-names = "default";
	clock-frequency = <100000>;
	i2c-sda-hold-time-ns = <449>;
	i2c-scl-rising-time-ns = <120>;
	i2c-scl-falling-time-ns = <20>;

	expander0: gpio@43 {
		compatible = "fcs,fxl6408";
		reg = <0x43>;
		gpio-controller;
		#gpio-cells = <2>;
	};

	expander1: gpio@44 {
		compatible = "fcs,fxl6408";
		reg = <0x44>;
		gpio-controller;
		#gpio-cells = <2>;
	};
};

&i2c2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_pmux>;
	clock-frequency = <100000>;

	dsi_bridge: lt9611@3b {
		compatible = "syna-bridge,lt9611";
		reg = <0x3b>;
		status = "okay";
		enable-gpio = <&expander0 1 0>;
		reset-gpio = <&expander0 7 1>;
	};
};

&sm_uart0 {
	status = "okay";
};

&sdhci0 {
	status = "okay";
	pad_sn = <10>;
	pad_sp = <10>;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	fixed-voltage;
};

&mux0 {
	status = "okay";
};

&sdhci2 {
	status="okay";
	pinctrl-0 = <&sdio2_pmux>;
	pinctrl-names = "default";
	sdhci-sdio;
	sd-uhs-sdr50;
	fixed-voltage;
	skip-phy;
	vmmc-supply = <&sdio2_vmmc>;
	vqmmc-supply = <&sdio2_vqmmc>;
	mux-controls = <&mux0 0>;
	mux-control-names = "mux-0";
	mux-0-value = <3>;
};

&gmac1 {
	status = "okay";
	phy-mode = "rgmii-id";
	phy-handle = <&phy1>;
	phy = <&phy1>;
	phy-reset-gpios = <&portf 3 GPIO_ACTIVE_HIGH>;
	pinctrl-names = "default";
	pinctrl-0 = <&eth1_pmux>, <&mdio_pmux>, <&eth1_phy1_rst_pmux>;

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		phy1: ethernet-phy@0 {
			reg = <0>;
		};
	};
};

&usb_phy0 {
	status = "okay";
};

&usb0 {
	compatible = "snps,dwc2-udc";
	status = "okay";
};

&usb_phy1 {
	status = "okay";
};

&usb1 {
	compatible = "snps,dwc2-host";
	status = "okay";
};

&xspi0 {
	status = "okay";
	pinctrl-0 = <&xspi0_pmux>;
	pinctrl-names = "default";

	spi-flash@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <10000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
	};
};

&drm {
	status = "okay";
	irqno = <69>;
	hdmitx_enable = <0>;
	disp-mode = <2>;
	disp1-bits_per_pixel = <24>;
	disp1-busformat = <0>;
	disp2-bits_per_pixel = <24>;
	disp2-busformat = <0>;

	lcdc_panel {
		status = "disabled";
		hact = <800>;
		hfp = <210>;
		hsa = <2>;
		hbp = <46>;
		vact = <480>;
		vfp = <22>;
		vsa = <2>;
		vbp = <23>;
		pixclockKhz = <33300>;
		rgbswap = <1>;
	};

	dsi_panel {
		compatible = "syna,mipi-dsi";
		status= "okay";

		NO_OF_RESID =  <1>;
		DSI_RES =  <102>;

		/* 1920x1080@60Hz for LT9611→HDMI output */
		ACTIVE_WIDTH = <1920>;
		HFP = <88>;
		HSYNCWIDTH = <44>;
		HBP = <148>;
		ACTIVE_HEIGHT = <1080>;
		VFP = <4>;
		VSYNCWIDTH = <5>;
		VBP = <36>;
		TYPE = <1>;
		SCAN = <0>;
		FRAME_RATE = <60>;
		FLAG_3D = <0>;
		FREQ = <148500>;
		PTS_PER_4 = <6000>;

		bits_per_pixel = <24>;
		busformat = <0>;

		VB_MIN = /bits/ 8 <6>;
		HB_MIN = /bits/ 8 <30>;
		V_OFF = /bits/ 8 <6>;
		H_OFF = /bits/ 8 <20>;
		HB_VOP_OFF = /bits/ 8 <8>;
		VB_VOP_OFF = /bits/ 8 <3>;
		HB_BE = /bits/ 8 <7>;
		VB_BE = /bits/ 8 <2>;
		VB_FP = /bits/ 8 <2>;
		HB_FP = /bits/ 8 <10>;
		PIXEL_CLOCK = <148500>;  /* 1080p60 pixel clock */

		HTOTAL = <2200>;  /* 1920 + 88 + 44 + 148 */
		Lanes = /bits/ 8 <4>;  /* 4 lanes for 1080p */
		Vid_mode = /bits/ 8 <2>;
		virtual_chan = /bits/ 8 <0>;
		Clk_Lane_Polarity = /bits/ 8 <0>;
		Data_Lane_Polarity = /bits/ 8 <0>;
		Recv_ack = /bits/ 8 <0>;
		Loosely_18 = /bits/ 8 <0>;
		H_polarity = /bits/ 8 <1>;
		V_Polarity = /bits/ 8 <1>;
		Data_Polarity = /bits/ 8 <1>;
		Eotp_tx = /bits/ 8 <1>;
		Eotp_rx = /bits/ 8 <0>;
		non-Continuous_clk = /bits/ 8 <0>;
		dpi_lp_cmd = /bits/ 8 <1>;
		Color_coding = /bits/ 8 <5>;
		Chunks = <0>;
		Null_Pkt = <0>;
		Byte_clk = <148500>;
		rgbswap = <0>;

		/*
		 * COMMAND= Command for initialisation
		 * Format - <CMD> <Payloadlength-n> <BYTE1> <...> <BYTEn>
		 * Long write Ex: 39 04 FF 98 81 03
		 *
		 * Delay in micro seconds Command format: 0xFF <4BYTE delay>
		 * Delay for 100ms(100000us => 0x000186A0)
		 *     - FF A0 86 01 00
		 */
		command = /bits/ 8 <0xFF 0x10 0x27 0x00 0x00>;
	};
};

